# .env de un entorno en el VPS: /srv/casa/<staging|produccion>/.env  (chmod 600, dueño deploy).
# Valores distintos en cada entorno. Nunca se sube al repositorio.

COMPOSE_PROJECT_NAME=casa-produccion          # casa-staging
IMAGEN_BACKEND=ghcr.io/<usuario>/casa-backend
IMAGEN_FRONTEND=ghcr.io/<usuario>/casa-frontend-produccion   # ...-staging
PUERTO_API=4000                               # staging: 4001
PUERTO_WEB=3000                               # staging: 3001
POSTGRES_PASSWORD=                            # openssl rand -hex 24

NODE_ENV=production                           # staging
LOG_LEVEL=info
API_PUBLIC_URL=https://casadelasbaterias.com.ar
FRONTEND_URL=https://casadelasbaterias.com.ar
REVALIDATE_SECRET=                            # openssl rand -hex 32

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guardarla también fuera del servidor: sin ella los DNI de las copias no se pueden leer.
DNI_ENCRYPTION_KEY=
DNI_KEY_VERSION=1

MP_ACCESS_TOKEN=                              # staging: credenciales de PRUEBA
MP_WEBHOOK_SECRET=

RESEND_API_KEY=
MAIL_FROM="La Casa de las Baterías <pedidos@mail.casadelasbaterias.com.ar>"
MAIL_ADMIN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

SENTRY_DSN=
