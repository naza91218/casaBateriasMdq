# --- General ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Base de datos (ver infra/docker-compose.dev.yml) ---
DATABASE_URL=postgres://casa:casa@localhost:5433/casa_dev
TEST_DATABASE_URL=postgres://casa:casa@localhost:5433/casa_test

# --- URLs ---
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=cambiar-por-un-secreto-largo

# --- Cifrado del DNI ---
# La de abajo es solo para desarrollo. En staging y producción, una distinta por entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Las sesiones del panel no usan secreto: son identificadores al azar guardados en la base.
DNI_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
DNI_KEY_VERSION=1

# --- Mercado Pago (credenciales de PRUEBA fuera de producción) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Mails ---
# En desarrollo se usa Mailpit (SMTP_DEV_HOST); en staging/producción, Resend.
RESEND_API_KEY=
MAIL_FROM="La Casa de las Baterías <pedidos@example.com>"
MAIL_ADMIN=admin@example.com
SMTP_DEV_HOST=localhost
SMTP_DEV_PORT=1025

# --- Fotos (Cloudflare R2). Vacío en desarrollo = disco local ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Errores ---
SENTRY_DSN=
